# ==============================================================================
# TEMPLE DIGITAL PLATFORM BACKEND — PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================

# ============================================================
# 1. REQUIRED PRODUCTION CONFIGURATION
# ============================================================
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
ENABLE_SWAGGER=false

# Allowed frontend origins for CORS (comma-separated, DO NOT USE * IN PRODUCTION)
CORS_ORIGINS=https://temple.example.com,https://admin.temple.example.com

# Managed PostgreSQL (PgBouncer connection pooler)
DATABASE_URL=postgresql://user:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&connection_limit=20
DIRECT_URL=postgresql://user:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Managed Redis (TLS rediss:// endpoint)
REDIS_URL=rediss://default:your_redis_password@your-endpoint.upstash.io:6379

# Cryptographically random JWT secrets (min 32 characters, generate with: openssl rand -base64 32)
JWT_SECRET=replace_with_min_32_characters_random_secret_string_here
JWT_REFRESH_SECRET=replace_with_min_32_characters_random_refresh_secret_here
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d

# ============================================================
# 2. CASHFREE PRODUCTION PAYMENT GATEWAY
# ============================================================
# Merchant Credentials from Cashfree Production Dashboard (https://merchant.cashfree.com/)
CASHFREE_APP_ID=your_cashfree_production_app_id
CASHFREE_SECRET_KEY=your_cashfree_production_secret_key
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_signing_secret
CASHFREE_ENVIRONMENT=production

# ============================================================
# 3. PRODUCTION SMS PROVIDER (MSG91 FOR INDIA DLT)
# ============================================================
# Provider type: 'msg91' for live production SMS, 'mock' for local dev
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_production_auth_key
MSG91_SENDER_ID=TEMPLE
MSG91_DLT_TE_ID=your_approved_dlt_template_id

# ============================================================
# 4. OBJECT STORAGE FOR MEDIA UPLOADS (S3 / CLOUDINARY)
# ============================================================
# Storage provider: 's3', 'cloudinary', or 'local_mock'
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=temple-production-assets
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Alternative: Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================
# 5. SCHEDULER & DISASTER RECOVERY
# ============================================================
CLEANUP_INTERVAL_MS=300000
BACKUP_DIR=./backups
BACKUP_RETENTION=14
S3_BACKUP_BUCKET=temple-production-db-backups

# Structured Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# ============================================================
# 6. DEVELOPMENT & TEST ONLY CONFIGURATION
# ============================================================
# DEV_OTP is IGNORED in production mode (NODE_ENV=production).
# Real cryptographically random OTPs are generated and hashed in production.
DEV_OTP=123456