# ==============================================================================
# TEMPLE DIGITAL PLATFORM BACKEND — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ==========================================
# 1. REQUIRED PRODUCTION CONFIGURATION
# ==========================================
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Allowed frontend origin(s) for CORS (comma-separated or * for public test)
# Example: https://temple.example.com,http://localhost:5173
CORS_ORIGINS=*

# PostgreSQL Database connection string (e.g. Supabase, Render Postgres, Neon, or local)
# Supabase Pooler: postgresql://postgres.xxxx:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://user:password@localhost:5432/temple?schema=public

# Redis connection string (e.g. Upstash, Render Redis, or local)
# Upstash TLS: rediss://default:your_upstash_password@your-endpoint.upstash.io:6379
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets (Must be at least 32 characters long)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_min_32_characters_random_string_here
JWT_REFRESH_SECRET=replace_with_min_32_characters_refresh_secret_here
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ==========================================
# 2. PAYMENTS (RAZORPAY)
# ==========================================
# Razorpay Key ID & Secret from Razorpay Dashboard (https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecretHere

# ==========================================
# 3. OTP & AUTHENTICATION SETTINGS
# ==========================================
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# DEV_OTP is only active when NODE_ENV !== production. In production it is ignored.
DEV_OTP=123456

# ==========================================
# 4. OPTIONAL INTEGRATIONS
# ==========================================
# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary (Media / Gallery storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info